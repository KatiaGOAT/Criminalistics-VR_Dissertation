--- !u!114 &1420069815
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1420069813}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17ee2a3702e108a46b9bd6f12759abab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InterrogationManager
  lines:
  - subtitleText: 'Investigator: We found your phone near the body. Care to explain
      that?'
    voiceClip: {fileID: 8300000, guid: 0afbd6301181f124bba0664014a8fcff, type: 3}
    delayAfterLine: 1
  - subtitleText: "Suspect: That doesn\u2019t prove anything. I lost it earlier that
      night."
    voiceClip: {fileID: 8300000, guid: 5d7e41888970c1741b6d5dc814ce4574, type: 3}
    delayAfterLine: 1
  - subtitleText: "Investigator: You also left rope fibers on the victim\u2019s wrist.
      The same type found in your car."
    voiceClip: {fileID: 8300000, guid: d37fd35d40c79354eac83165696a6530, type: 3}
    delayAfterLine: 1
  - subtitleText: "Suspect: No\u2026 no, that\u2019s impossible. Someone planted
      that!"
    voiceClip: {fileID: 8300000, guid: e3546d72e4bf17e4a9195a1fd11d596a, type: 3}
    delayAfterLine: 1
  - subtitleText: "Investigator: Then how do you explain the watch? The victim\u2019s
      watch \u2014 found in the bathroom."
    voiceClip: {fileID: 8300000, guid: bb4012b2056d1a44abdd0e45e571a776, type: 3}
    delayAfterLine: 1
  - subtitleText: "Suspect: I didn\u2019t mean to\u2014 it wasn\u2019t supposed to
      happen like this."
    voiceClip: {fileID: 8300000, guid: 1a8cea76ce474b8449f0236680d1d6d6, type: 3}
    delayAfterLine: 1
  - subtitleText: 'Investigator: So you admit it. You killed her.'
    voiceClip: {fileID: 8300000, guid: ebc844edb34cf9a4fa5d335abf298c84, type: 3}
    delayAfterLine: 1
  - subtitleText: "Suspect: She pushed me too far\u2026 I just wanted to scare her."
    voiceClip: {fileID: 8300000, guid: 4153ad3f1a377374980dc56cace4113d, type: 3}
    delayAfterLine: 1
  - subtitleText: 'Investigator: The truth is out. The case is solved.'
    voiceClip: {fileID: 8300000, guid: e04ef4299c0a9dc40aa6e8f935e375f4, type: 3}
    delayAfterLine: 1
  subtitleTextUI: {fileID: 948201932}
  interrogationUI: {fileID: 1964155481}
  endUI: {fileID: 1387971971}
  interrogationSetup: {fileID: 783636129}
  dialogueAudio: {fileID: 136229509}
  suspectAnimator: {fileID: 478026447}
